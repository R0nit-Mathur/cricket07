{
  "version": 2,
  "builds": [
    { "src": "site/**/*.*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/site/index.html" },
    { "src": "/play", "dest": "/site/play/index.html" },
    { "src": "/play/(.*)", "dest": "/site/play/$1" },
    { "src": "/(.*)", "dest": "/site/$1" }
  ]
}
